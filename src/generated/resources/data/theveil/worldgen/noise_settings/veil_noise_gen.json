{
  "aquifers_enabled": false,
  "default_block": {
    "Name": "theveil:veilstone"
  },
  "default_fluid": {
    "Name": "minecraft:air"
  },
  "disable_mob_generation": true,
  "legacy_random_source": false,
  "noise": {
    "height": 128,
    "min_y": 0,
    "size_horizontal": 1,
    "size_vertical": 1
  },
  "noise_router": {
    "barrier": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_barrier",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "continents": {
      "type": "minecraft:noise",
      "noise": "minecraft:continentalness",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "depth": {
      "type": "minecraft:add",
      "argument1": 0.0,
      "argument2": {
        "type": "minecraft:mul",
        "argument1": 2.0,
        "argument2": {
          "type": "minecraft:noise",
          "noise": "minecraft:ridge",
          "xz_scale": 1.0,
          "y_scale": 1.0
        }
      }
    },
    "erosion": {
      "type": "minecraft:noise",
      "noise": "minecraft:erosion",
      "xz_scale": 1.0,
      "y_scale": 0.5
    },
    "final_density": {
      "type": "minecraft:add",
      "argument1": 60.0,
      "argument2": {
        "type": "minecraft:mul",
        "argument1": 16.0,
        "argument2": {
          "type": "minecraft:noise",
          "noise": "minecraft:erosion_large",
          "xz_scale": 1.0,
          "y_scale": 1.0
        }
      }
    },
    "fluid_level_floodedness": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_fluid_level_floodedness",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "fluid_level_spread": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_fluid_level_spread",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "initial_density_without_jaggedness": {
      "type": "minecraft:add",
      "argument1": 0.0,
      "argument2": {
        "type": "minecraft:mul",
        "argument1": 0.5,
        "argument2": {
          "type": "minecraft:noise",
          "noise": "minecraft:continentalness_large",
          "xz_scale": 1.0,
          "y_scale": 1.0
        }
      }
    },
    "lava": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_lava",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "ridges": {
      "type": "minecraft:noise",
      "noise": "minecraft:jagged",
      "xz_scale": 1.0,
      "y_scale": 0.25
    },
    "temperature": {
      "type": "minecraft:noise",
      "noise": "minecraft:temperature",
      "xz_scale": 1.0,
      "y_scale": 0.25
    },
    "vegetation": {
      "type": "minecraft:noise",
      "noise": "minecraft:vegetation",
      "xz_scale": 1.0,
      "y_scale": 0.25
    },
    "vein_gap": {
      "type": "minecraft:noise",
      "noise": "minecraft:ore_gap",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "vein_ridged": {
      "type": "minecraft:noise",
      "noise": "minecraft:ore_vein_a",
      "xz_scale": 1.0,
      "y_scale": 1.0
    },
    "vein_toggle": {
      "type": "minecraft:noise",
      "noise": "minecraft:ore_veininess",
      "xz_scale": 1.0,
      "y_scale": 1.0
    }
  },
  "ore_veins_enabled": false,
  "sea_level": 60,
  "spawn_target": [],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "add_surface_depth": false,
          "offset": 1,
          "secondary_depth_range": 0,
          "surface_type": "floor"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "theveil:bryophyte_covered_peat",
            "Properties": {
              "snowy": "false"
            }
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "add_surface_depth": true,
          "offset": 3,
          "secondary_depth_range": 0,
          "surface_type": "floor"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "theveil:peat"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "add_surface_depth": true,
          "offset": 7,
          "secondary_depth_range": 0,
          "surface_type": "floor"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "theveil:gleysol"
          }
        }
      },
      {
        "type": "minecraft:block",
        "result_state": {
          "Name": "theveil:veilstone"
        }
      }
    ]
  }
}